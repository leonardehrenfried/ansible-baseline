{
  "options": {
    "paths": {
      "root": "/usr/src/app/node_modules/tileserver-gl-styles",
      "sprites": "/data/sprites",
      "fonts": "/data/fonts",
      "styles": "/data",
      "mbtiles": "/data"
    },
    "maxRendererPoolSizes": [2, 2],
    "serveAllFonts": true,
    "maxSize": 1024,
    "maxScaleFactor": 2,
    "tileMargin": {{ tileserver_tile_margin }},
    "leafletRetina": true
  },
  "styles": {
    "streets": {
      "style": "streets.json",
      "serve_data": true,
      "tilejson": {
        "bounds": [
          7.372216,
          47.18741,
          10.514946,
          49.794564
        ]
      }
      {% if streets_serve_rendered is false %}
      ,
      "serve_rendered": false
      {% endif %}
    },
    "satellite-overlay": {
      "style": "satellite-overlay.json",
      "serve_data": true,
      "tilejson": {
        "bounds": [
          7.372216,
          47.18741,
          10.514946,
          49.794564
        ]
      }
      {% if satellite_overlay_serve_rendered is false %}
      ,
      "serve_rendered": false
      {% endif %}
    },
    "bicycle": {
      "style": "bicycle.json",
      "serve_data": true,
      "tilejson": {
        "bounds": [
          7.372216,
          47.18741,
          10.514946,
          49.794564
        ]
      }
      {% if bicycle_serve_rendered is false %}
      ,
      "serve_rendered": false
      {% endif %}
    }
{% for extra_style in tileserver_extra_styles %}
    ,
    "{{ extra_style.name }}": {
      "style": "{{ extra_style.name }}.json",
      "serve_data": true,
      "serve_rendered": {{ extra_style.serve_rendered | tojson }}
    }
{% endfor %}
  },
  "data": {
    "v3": {
      "mbtiles": "input.mbtiles"
    }
{% for source in tileserver_extra_sources %}
    ,
    "{{ source.name }}": {
      "mbtiles": "{{ source.path }}"
    }
{% endfor %}
  }
}
